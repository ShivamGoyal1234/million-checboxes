{
  "name": "million-checkboxes",
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time collaborative checkbox grid with Redis, WebSockets, and OIDC",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "docker:up": "docker compose up --build",
    "docker:up:detached": "docker compose up -d --build",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:dev:detached": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.14.2",
    "ioredis": "^5.3.2",
    "oidc-provider": "^8.4.6",
    "express-session": "^1.17.3",
    "connect-redis": "^7.1.0",
    "jose": "^5.2.0",
    "dotenv": "^16.3.1"
  }
}
