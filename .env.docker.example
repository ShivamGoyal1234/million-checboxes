# Variables for `docker compose` (optional `.env` next to docker-compose.yml).
# Redis is always the bundled Docker service `redis` — `REDIS_URL` is set inside
# docker-compose.yml to redis://redis:6379. You normally do not set REDIS_URL here.

HOST_PORT=3000

# Required in production (generate a long random string)
# SESSION_SECRET=

# Must match the browser-visible origin (scheme + host + port)
# OIDC_ISSUER=https://your-domain.com/oidc
# REDIRECT_URI=https://your-domain.com/auth/callback

# Optional
# TOTAL_CHECKBOXES=100000
# CLIENT_ID=checkbox-app
# CLIENT_SECRET=checkbox-secret
