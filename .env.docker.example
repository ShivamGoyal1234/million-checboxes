# =============================================================================
# Production Docker — copy to `.env` next to docker-compose.prod.yml
#   cp .env.docker.example .env
# Fill every REQUIRED value; never commit `.env`.
#
# Start: docker compose -f docker-compose.prod.yml up -d --build
# =============================================================================

# --- Set by docker-compose.prod.yml (do not duplicate unless you know why) ---
# NODE_ENV=production
# PORT=3000
# REDIS_URL=redis://redis:6379

# --- REQUIRED: session signing (min ~32 random bytes) -------------------------
# Generate: openssl rand -base64 48
SESSION_SECRET=C/Kis4AIca4ovIgP+4FAEtXCsccgXWWgVV8Vrb9OsleKwsrShVV96aJmgxrPmAJc

# --- REQUIRED: public URLs (HTTPS + your real host; no trailing slash extras) -
# Issuer must match what browsers hit. Path is fixed at /oidc for this app.
OIDC_ISSUER=https://checkbox.shivam-goyal.site/oidc
REDIRECT_URI=https://checkbox.shivam-goyal.site/auth/callback

# --- REQUIRED: OIDC client (use strong secret in production) ----------------
CLIENT_ID=checkbox-app
# Generate: openssl rand -base64 32
CLIENT_SECRET=mvkWG4EQVy5YLfgJPjesovyOqaMNIjUFQ3SqMjUnmFw=

# --- Optional ----------------------------------------------------------------
# Grid size (default 100000). Larger = more Redis memory for the bitfield.
# TOTAL_CHECKBOXES=100000
